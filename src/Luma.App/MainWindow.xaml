             <Border.OpacityTransition><ScalarTransition Duration="0:0:0.16"/></Border.OpacityTransition>
             <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#9E000000" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Border Visibility="{Binding VideoBadgeVisibility}" IsHitTestVisible="False" Background="#BF141418" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="6" Padding="6,2" Margin="6">
             <TextBlock Text="{Binding VideoBadgeText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
            </Border>
            <Border Visibility="{Binding OfflineBadgeVisibility}" IsHitTestVisible="False" Background="#BF141418" VerticalAlignment="Bottom" HorizontalAlignment="Right" CornerRadius="6" Padding="6,2" Margin="6">
             <TextBlock Text="Offline" Foreground="White" FontSize="10"/>
            </Border>
            <Border Visibility="{Binding FavoriteBadgeVisibility}" IsHitTestVisible="False" Background="#B018181B" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Padding="6,2" Margin="6">
             <TextBlock Text="★" Foreground="#FBBF24" FontSize="11"/>
            </Border>
