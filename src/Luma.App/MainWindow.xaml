      </StackPanel>
     </DataTemplate></GridView.ItemTemplate>
     <GridView.ContextFlyout><MenuFlyout Closed="ExclusionMenuClosed" Opening="GalleryContextMenuOpening"><MenuFlyoutItem Text="Open" Click="OpenSelected" ToolTipService.ToolTip="Open this original in your default Windows application. Requires the source to be connected." AutomationProperties.HelpText="Open this original in your default Windows application. Requires the source to be connected."/><MenuFlyoutItem x:Name="ContextStackToggle" Text="Expand / collapse stack" Click="ToggleSelectedStack" Visibility="Collapsed"/><MenuFlyoutItem x:Name="ContextShowOnMap" Text="Show on map" Click="ShowSelectedOnMap" Visibility="Collapsed"/><MenuFlyoutItem Text="Pin location on map…" Click="PinSelectedOnMap"/><MenuFlyoutItem Text="Show in Explorer" Click="RevealSelected" ToolTipService.ToolTip="Reveal this original in Windows Explorer." AutomationProperties.HelpText="Reveal this original in Windows Explorer."/><MenuFlyoutItem Text="Copy path" Click="CopyPath" ToolTipService.ToolTip="Copy full paths of selected originals as text." AutomationProperties.HelpText="Copy full paths of selected originals as text."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Exclude this folder…" Click="ExcludeFolder" ToolTipService.ToolTip="Hide this folder and its subfolders from this source and future scans. Originals are retained." AutomationProperties.HelpText="Hide this folder and its subfolders from this source and future scans. Originals are retained."/><MenuFlyoutItem Text="Exclude this source…" Click="ExcludeSource" ToolTipService.ToolTip="Hide this whole registered source and skip future scans until restored." AutomationProperties.HelpText="Hide this whole registered source and skip future scans until restored."/><MenuFlyoutItem Text="Exclude this file type…" Click="ExcludeType" ToolTipService.ToolTip="Hide this extension across all sources and skip it during scanning." AutomationProperties.HelpText="Hide this extension across all sources and skip it during scanning."/><MenuFlyoutItem Text="Manage exclusions…" Click="ManageExclusions" ToolTipService.ToolTip="Review folder, source and extension rules; restore hidden media here." AutomationProperties.HelpText="Review folder, source and extension rules; restore hidden media here."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Copy" Click="CopySelected" ToolTipService.ToolTip="Copy selected original files to the Windows clipboard (Ctrl+C). Reconnect offline sources first." AutomationProperties.HelpText="Copy selected original files to the Windows clipboard (Ctrl+C). Reconnect offline sources first."/><MenuFlyoutItem Text="Cut" Click="CutSelected" ToolTipService.ToolTip="Prepare selected originals for moving (Ctrl+X). Files move only when pasted." AutomationProperties.HelpText="Prepare selected originals for moving (Ctrl+X). Files move only when pasted."/><MenuFlyoutItem Text="Paste into folder…" Click="PasteSelected" ToolTipService.ToolTip="Choose a destination and paste copied or cut originals (Ctrl+V). Existing filenames are skipped." AutomationProperties.HelpText="Choose a destination and paste copied or cut originals (Ctrl+V). Existing filenames are skipped."/><MenuFlyoutItem Text="Copy to folder…" Click="CopyToFolder" ToolTipService.ToolTip="Copy selected originals into another folder; leave originals in place." AutomationProperties.HelpText="Copy selected originals into another folder; leave originals in place."/><MenuFlyoutItem Text="Move to folder…" Click="MoveToFolder" ToolTipService.ToolTip="Move selected originals into another folder. Review the operation result for skipped files." AutomationProperties.HelpText="Move selected originals into another folder. Review the operation result for skipped files."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Add to album…" Click="AddToAlbum" ToolTipService.ToolTip="Add selected media to a virtual album without moving originals." AutomationProperties.HelpText="Add selected media to a virtual album without moving originals."/><MenuFlyoutItem Text="Remove from this album" Click="RemoveFromAlbum" ToolTipService.ToolTip="Remove membership from this album; keep originals, tags and favorites." AutomationProperties.HelpText="Remove membership from this album; keep originals, tags and favorites."/><MenuFlyoutItem Text="Select all matching results" Click="SelectAllMatching" ToolTipService.ToolTip="Select every result in this filtered view, including unloaded items. Large selections use more memory." AutomationProperties.HelpText="Select every result in this filtered view, including unloaded items. Large selections use more memory."/><MenuFlyoutItem Text="Rename…" Click="RenameSelected" ToolTipService.ToolTip="Rename the selected original file (F2), or batch rename multiple files." AutomationProperties.HelpText="Rename the selected original file (F2). Its extension must be retained."/><MenuFlyoutItem Text="Delete to Recycle Bin…" Click="DeleteSelected" ToolTipService.ToolTip="Ask Windows to delete selected originals. Review the Recycle Bin confirmation carefully." AutomationProperties.HelpText="Ask Windows to delete selected originals. Review the Recycle Bin confirmation carefully."/></MenuFlyout></GridView.ContextFlyout>
    </GridView>

    <!-- Adaptive Proportions / Moments Justified Row View -->
    <ListView x:Name="JustifiedRowsList" Visibility="Collapsed" SelectionMode="None" IsSynchronizedWithCurrentItem="False" Loaded="JustifiedListLoaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContainerContentChanging="JustifiedRowChanging" SizeChanged="JustifiedList_SizeChanged" PointerWheelChanged="GalleryWheel">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,0,0,8">
       <TextBlock Text="{Binding GroupHeader}" Visibility="{Binding HeaderVisibility}" FontSize="20" FontWeight="SemiBold" CharacterSpacing="-15" Margin="4,16,0,8"/>
       <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Width="{Binding AdaptiveWidth}" Spacing="4" Opacity="{Binding CutOpacity}" IsTabStop="True" UseSystemFocusVisuals="True" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding TooltipText}" Tapped="AdaptiveCardTapped" DoubleTapped="AdaptiveCardDoubleTapped" RightTapped="AdaptiveCardRightTapped" KeyDown="AdaptiveCardKeyDown" PointerEntered="CardPointerEntered" PointerExited="CardPointerExited">
          <Border Height="{Binding AdaptiveHeight}" Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" BorderThickness="{Binding AdaptiveSelectionThickness}" CornerRadius="12">
           <Grid x:Name="CardViewport" CornerRadius="10">
            <FontIcon Glyph="&#xEB9F;" Visibility="{Binding PlaceholderVisibility}" Opacity="0.22" FontSize="28"/>
