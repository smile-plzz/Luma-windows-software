    <Grid x:Name="MapOfflinePanel">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="MapConsentCard" Background="{ThemeResource LumaSidebar}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="14,10,14,0">
      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Online Map Privacy Notice (One-Time Per Session)" FontSize="13" FontWeight="SemiBold"/>
        <TextBlock Text="Zero telemetry or background calls. Loading the online map fetches public OpenStreetMap tiles inside this window only; your files and exact coordinates stay strictly on your PC." TextWrapping="Wrap" FontSize="11" Opacity="0.72"/>
       </StackPanel>
       <Button Grid.Column="1" Content="Load online map (this session)" Click="GrantMapOnlineConsent" Background="{ThemeResource LumaControl}" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button Grid.Column="2" Content="✕" Click="DismissMapConsentBanner" ToolTipService.ToolTip="Hide notice" VerticalAlignment="Center" Padding="7,4"/>
      </Grid>
     </Border>

     <!-- Interactive Minimal Offline World Coordinate Canvas -->
     <Border Grid.Row="1" Background="{ThemeResource LumaSidebar}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="14" Margin="14,10,14,10">
      <Grid CornerRadius="14">
       <Canvas x:Name="OfflineMapCanvas" Background="Transparent" SizeChanged="OfflineCanvas_SizeChanged" PointerPressed="OfflineCanvas_PointerPressed" PointerMoved="OfflineCanvas_PointerMoved" PointerReleased="OfflineCanvas_PointerReleased" PointerWheelChanged="OfflineCanvas_PointerWheelChanged"/>
       <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="4" Background="{ThemeResource LumaCanvas}" CornerRadius="9">
        <Button Content="+" Click="OfflineZoomInClicked" Padding="8,4" ToolTipService.ToolTip="Zoom in"/>
        <Button Content="-" Click="OfflineZoomOutClicked" Padding="8,4" ToolTipService.ToolTip="Zoom out"/>
        <Button Content="Fit all" Click="OfflineFitClicked" Padding="8,4" FontSize="12"/>
        <Button Content="Filter gallery to view" Click="OfflineFilterBoundsClicked" Padding="8,4" FontSize="12" Background="{ThemeResource LumaControl}"/>
       </StackPanel>
       <Border x:Name="OfflinePinHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="12,6" CornerRadius="999" Background="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="Collapsed">
        <TextBlock x:Name="OfflinePinHintText" Text="Click anywhere on the map to assign catalog coordinates" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
       </Border>
       <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4" CornerRadius="6" Background="{ThemeResource LumaCanvas}" Opacity="0.82">
        <TextBlock x:Name="OfflineMapModeBadge" Text="Offline coordinate canvas" FontSize="10"/>
       </Border>
      </Grid>
     </Border>
    </Grid>

    <!-- Lazy WebView2 Host (only populated on explicit consent) -->
    <Grid x:Name="MapWebHost" Visibility="Collapsed" Margin="14,10,14,10" CornerRadius="14"/>

    <!-- Right Collapsible Drawer: Clusters | Place Tags | Unlocated -->
    <Border x:Name="MapDrawerPanel" Grid.Column="1" Width="324" Background="{ThemeResource LumaSidebar}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1,0,0,0" Padding="12">
     <Grid RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{ThemeResource LumaControl}" CornerRadius="9" Padding="3">
       <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="MapTabClusters" Content="Clusters" IsChecked="True" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11"/>
        <ToggleButton x:Name="MapTabPlaceTags" Grid.Column="1" Content="Place tags" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11"/>
        <ToggleButton x:Name="MapTabUnlocated" Grid.Column="2" Content="Unlocated" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11"/>
       </Grid>
      </Border>

      <Grid Grid.Row="1">
       <TextBlock x:Name="MapDrawerEmpty" Text="No location items in this view." TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="6,12" Visibility="Collapsed"/>

       <ListView x:Name="MapOfflineGroupsList" SelectionMode="None">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="6">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Zoom" Tag="{Binding}" Click="MapOfflineGroupZoomClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="Filter gallery" Tag="{Binding}" Click="MapOfflineGroupFilterClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="OSM" Tag="{Binding}" Click="MapOfflineGroupBrowserClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>

       <ListView x:Name="MapPlaceTagsList" SelectionMode="None" Visibility="Collapsed">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="5">
           <TextBlock Text="{Binding LocationName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Preview" Tag="{Binding}" Click="MapDrawerItemPreviewClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="Pin coords…" Tag="{Binding}" Click="MapDrawerItemPinClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>

       <ListView x:Name="MapUnlocatedList" SelectionMode="None" Visibility="Collapsed">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="5">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Preview" Tag="{Binding}" Click="MapDrawerItemPreviewClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="Pin on map…" Tag="{Binding}" Click="MapDrawerItemPinClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Grid>
     </Grid>
    </Border>
   </Grid>

   <!-- Collapsible Viewport Filmstrip Bar -->
   <Border x:Name="MapFilmstripBar" Grid.Row="3" Height="116" Background="{ThemeResource LumaSidebar}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="0,1,0,0" Padding="12,6">
    <Grid RowSpacing="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="MapFilmstripHeader" Text="Visible in map area" FontSize="11" Opacity="0.65"/>
     <ListView x:Name="MapFilmstripList" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="MapFilmstripItemClicked" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="0"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate>
       <Border Width="108" Height="74" CornerRadius="8" Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" ToolTipService.ToolTip="{Binding Tooltip}">
        <Grid CornerRadius="8">
         <FontIcon Glyph="&#xEB9F;" Opacity="0.22" FontSize="20"/>
         <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
         <Border VerticalAlignment="Bottom" Background="#A6000000" Padding="5,2">
          <TextBlock Text="{Binding Label}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis"/>
         </Border>
        </Grid>
       </Border>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
  </Grid>
 </Grid>
 </ContentControl>
</Window>
