            </Border>
            <Button Visibility="{Binding StackVisibility}" Click="CardStackBadgeClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7,3" CornerRadius="10" Background="#B018181B" AutomationProperties.Name="Expand or collapse stack" ToolTipService.ToolTip="Expand or collapse stack">
             <TextBlock Text="{Binding StackBadgeText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Button>
            <Button Opacity="{Binding QuickActionOpacity}" IsHitTestVisible="{Binding IsHovered}" Click="CardQuickFavoriteClick" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="8" Background="#C818181B" AutomationProperties.Name="Toggle favorite" ToolTipService.ToolTip="Toggle favorite">
             <Button.OpacityTransition><ScalarTransition Duration="0:0:0.14"/></Button.OpacityTransition>
             <TextBlock Text="{Binding FavoriteGlyph}" Foreground="White" FontSize="12"/>
            </Button>
            <Border IsHitTestVisible="False" BorderBrush="{ThemeResource LumaCardHoverBorder}" BorderThickness="1.5" CornerRadius="10" Opacity="{Binding HoverBorderOpacity}">
             <Border.OpacityTransition><ScalarTransition Duration="0:0:0.14"/></Border.OpacityTransition>
            </Border>
           </Grid>
          </Border>
          <TextBlock Text="{Binding Name}" Visibility="{Binding Labels}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Caption}" Visibility="{Binding Details}" FontSize="10" Opacity="0.65"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </DataTemplate></ListView.ItemTemplate>
