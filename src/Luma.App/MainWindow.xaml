<Window x:Class="Luma.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma">
 <ContentControl x:Name="ViewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid x:Name="Root" Background="{ThemeResource LumaCanvas}" Loaded="OnLoaded">
  <Grid.Resources>
   <ResourceDictionary>
    <Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="ToggleButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="{ThemeResource LumaControl}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{ThemeResource LumaControl}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,1"/></Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyShortcut"/><KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutShortcut"/><KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteShortcut"/><KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectShortcut"/><KeyboardAccelerator Key="Delete" Invoked="DeleteShortcut"/><KeyboardAccelerator Key="F2" Invoked="RenameShortcut"/>
   <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/><KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleSidebarShortcut"/><KeyboardAccelerator Key="H" Modifiers="Control" Invoked="ToggleHeaderShortcut"/>
   <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackHistoryShortcut"/><KeyboardAccelerator Key="Home" Invoked="ScrollTopShortcut"/><KeyboardAccelerator Key="End" Invoked="ScrollBottomShortcut"/>
   <KeyboardAccelerator Key="F5" Invoked="RefreshShortcut"/><KeyboardAccelerator Key="Enter" Invoked="OpenShortcut"/><KeyboardAccelerator Key="Escape" Invoked="EscapeShortcut"/>
   <KeyboardAccelerator Key="Space" Invoked="SpacePreviewShortcut"/>
  </Grid.KeyboardAccelerators>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Collapsible Sidebar -->
  <Border x:Name="SidebarPanel" Background="{ThemeResource LumaSidebar}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="14,20,14,16" Spacing="8">
     <StackPanel Margin="10,0,0,10" Spacing="2">
      <TextBlock Text="Luma" FontSize="24" FontWeight="SemiBold" CharacterSpacing="-30"/>
      <TextBlock Text="A calm home for your moments" FontSize="11" Opacity="0.6"/>
     </StackPanel>

     <!-- Collapsible Views Section -->
     <Button x:Name="ViewsHeaderButton" Click="ToggleViewsSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" AutomationProperties.Name="Views section">
      <TextBlock x:Name="ViewsHeaderLabel" Text="▾ Views" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
     </Button>
     <StackPanel x:Name="ViewsSection" Spacing="4">
      <ListView x:Name="Navigation" SelectionChanged="NavigationChanged" SelectedIndex="0"><x:String>Library</x:String><x:String>Photos</x:String><x:String>Videos</x:String><x:String>Favorites</x:String><x:String>On this day</x:String></ListView>
     </StackPanel>

     <!-- Collapsible Albums Section -->
     <Button x:Name="AlbumsHeaderButton" Click="ToggleAlbumsSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,8,0,0" AutomationProperties.Name="Albums section">
      <TextBlock x:Name="AlbumsHeaderLabel" Text="▾ Albums" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
     </Button>
     <StackPanel x:Name="AlbumsSection" Spacing="6">
      <ComboBox x:Name="AlbumsBox" PlaceholderText="Choose an album" HorizontalAlignment="Stretch" SelectionChanged="AlbumChanged" AutomationProperties.Name="Album filter" AllowDrop="True" DragOver="AlbumDragOver" Drop="AlbumDrop" ToolTipService.ToolTip="Browse a virtual album. Drag selected media here to add it." AutomationProperties.HelpText="Browse a virtual album. Drag selected media here to add it."/>
      <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="+ Album" Click="NewAlbum" ToolTipService.ToolTip="Create a virtual album without moving or duplicating original files." AutomationProperties.HelpText="Create a virtual album without moving or duplicating original files."/><Button Content="⋯" AutomationProperties.Name="Album actions"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Rename album" Click="RenameAlbum" ToolTipService.ToolTip="Change the album label without renaming folders." AutomationProperties.HelpText="Change the album label without renaming folders."/><MenuFlyoutItem Text="Delete album" Click="DeleteAlbum" ToolTipService.ToolTip="Delete this virtual album only; its original files remain intact." AutomationProperties.HelpText="Delete this virtual album only; its original files remain intact."/><MenuFlyoutItem Text="Show all albums' media" Click="LeaveAlbum" ToolTipService.ToolTip="Clear the album filter." AutomationProperties.HelpText="Clear the album filter."/></MenuFlyout></Button.Flyout></Button></StackPanel>
     </StackPanel>

     <!-- Collapsible Smart Collections Section -->
     <Button x:Name="SmartCollectionsHeaderButton" Click="ToggleSmartCollectionsSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,8,0,0" AutomationProperties.Name="Smart collections section">
      <TextBlock x:Name="SmartCollectionsHeaderLabel" Text="▸ Smart collections" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
     </Button>
     <StackPanel x:Name="SmartCollectionsSection" Spacing="6" Visibility="Collapsed">
      <ComboBox x:Name="SmartCollectionsBox" PlaceholderText="Choose a collection" HorizontalAlignment="Stretch" SelectionChanged="SmartCollectionChanged" AutomationProperties.Name="Smart collections" ToolTipService.ToolTip="Apply a saved dynamic filter across your catalog." AutomationProperties.HelpText="Apply a saved dynamic filter across your catalog."/>
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button Content="+ Save view" Click="SaveCurrentAsSmartCollection" ToolTipService.ToolTip="Save current active filters as a reusable Smart Collection."/>
       <Button Content="⋯" AutomationProperties.Name="Smart collection actions"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Delete selected collection" Click="DeleteSmartCollection"/><MenuFlyoutItem Text="Clear collection filter" Click="ClearSmartCollection"/></MenuFlyout></Button.Flyout></Button>
      </StackPanel>
     </StackPanel>

     <!-- Collapsible Folders & Drives Section -->
     <Button x:Name="SourcesHeaderButton" Click="ToggleSourcesSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,8,0,0" AutomationProperties.Name="Folders and drives section">
      <TextBlock x:Name="SourcesHeaderLabel" Text="▾ Folders &amp; drives" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
     </Button>
     <StackPanel x:Name="SourcesSection" Spacing="6">
      <Button Content="Manage sources" Click="ManageSources" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Browse, rename, refresh or remove a registered source. Removal never deletes originals." AutomationProperties.HelpText="Browse, rename, refresh or remove a registered source. Removal never deletes originals."/>
      <ComboBox x:Name="Sources" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="Source filter" ToolTipService.ToolTip="Filter by a registered drive or folder, including offline sources." AutomationProperties.HelpText="Filter by a registered drive or folder, including offline sources."/>
      <StackPanel x:Name="FolderNavigation" Spacing="6" Visibility="Collapsed">
       <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="FolderBreadcrumbs">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding RelativePath}" Click="BreadcrumbClicked" Padding="6,3" FontSize="11" Background="{ThemeResource LumaControl}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
       <TextBox x:Name="FolderFilter" PlaceholderText="Folder within source" TextChanged="SearchChanged" AutomationProperties.Name="Folder path" ToolTipService.ToolTip="Filter by a folder relative to the selected source." AutomationProperties.HelpText="Filter by a folder relative to the selected source."/>
       <Button Content="Up to parent folder" Click="ParentFolder" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Go up one folder using the saved catalog, even when the drive is offline." AutomationProperties.HelpText="Go up one folder using the saved catalog, even when the drive is offline."/>
       <TextBlock x:Name="FolderHint" Text="Select a source to browse folders" FontSize="11" TextWrapping="Wrap" Opacity="0.6"/>
       <ListView x:Name="FolderList" MaxHeight="180" SelectionMode="Single" SelectionChanged="FolderSelected" RightTapped="FolderRightTapped" AutomationProperties.Name="Cached folders" AllowDrop="True" DragOver="FolderDragOver" Drop="FolderDrop">
        <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaCount}" FontSize="10" Opacity="0.55"/></StackPanel></DataTemplate></ListView.ItemTemplate>
        <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Open folder in Explorer" Click="RevealSelectedFolder"/><MenuFlyoutItem Text="Exclude this folder…" Click="ExcludeSelectedFolder"/></MenuFlyout></ListView.ContextFlyout>
       </ListView>
      </StackPanel>
      <Button x:Name="AddSourceButton" Content="+ Add folder or drive" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="AddSource" ToolTipService.ToolTip="Add an existing folder or drive. Originals stay where they are; known drives open from the saved catalog." AutomationProperties.HelpText="Add an existing folder or drive. Originals stay where they are; known drives open from the saved catalog."/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="1" Padding="14,6,14,10" Spacing="2">
    <Button Content="Storage &amp; previews" Click="StorageSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Check offline coverage, repair or rebuild previews, and manage local cache space." AutomationProperties.HelpText="Check offline coverage, repair or rebuild previews, and manage local cache space."/>
    <Button Content="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings" ToolTipService.ToolTip="Choose appearance, cache size, startup position and exclusions." AutomationProperties.HelpText="Choose appearance, cache size, startup position and exclusions."/>
   </StackPanel></Grid>
  </Border>

  <!-- Main Canvas -->
  <Grid Grid.Column="1" Padding="20,14,20,10" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Compact Top Header -->
   <Grid ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
     <Button x:Name="SidebarToggleButton" Content="☰" Click="ToggleSidebar" AutomationProperties.Name="Toggle sidebar" ToolTipService.ToolTip="Show or hide sidebar (Ctrl+B)"/>
     <Button x:Name="BackHistoryButton" Content="←" Click="NavigateBack" Visibility="Collapsed" AutomationProperties.Name="Back" ToolTipService.ToolTip="Go back to previous view (Alt+Left)"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
     <TextBlock x:Name="Heading" Text="Library" FontSize="24" FontWeight="SemiBold" CharacterSpacing="-20" VerticalAlignment="Center"/>
     <TextBlock x:Name="LibrarySummary" Text="Your moments, together." FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <Border x:Name="VisibleTimePill" Background="{ThemeResource LumaControl}" CornerRadius="6" Padding="8,3" Visibility="Collapsed" VerticalAlignment="Center">
      <TextBlock x:Name="VisibleTimeRange" FontSize="11" Opacity="0.8"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <TextBox x:Name="SearchBox" Width="210" PlaceholderText="Search, tag:, ext:, size:>" TextChanged="SearchChanged" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center" AutomationProperties.Name="Search library" ToolTipService.ToolTip="Search filenames, folders, tags, or operators (tag:, ext:, year:, date:, size:>10mb, is:untagged, has:gps)." AutomationProperties.HelpText="Search saved filenames, folders and tags without scanning your drive."/>
     <Button x:Name="SearchHelperButton" Content="▾" Padding="8,7" AutomationProperties.Name="Search helpers and history" ToolTipService.ToolTip="Recent searches and quick filter operators">
      <Button.Flyout><Flyout x:Name="SearchHelperFlyout" Opening="SearchHelperFlyout_Opening"><StackPanel x:Name="SearchHelperPanel" Width="260" Spacing="6"/></Flyout></Button.Flyout>
     </Button>
     <Button Content="Refresh" AutomationProperties.Name="Refresh library"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Refresh this source" Click="RefreshSelectedSource" ToolTipService.ToolTip="Discover changed files in the selected connected source. Resume a paused scan when available." AutomationProperties.HelpText="Discover changed files in the selected connected source. Resume a paused scan when available."/><MenuFlyoutItem Text="Refresh all connected sources" Click="RefreshAllSources" ToolTipService.ToolTip="Discover changed files across connected sources. Offline sources are kept." AutomationProperties.HelpText="Discover changed files across connected sources. Offline sources are kept."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Update drive status only" Click="RefreshDriveStatus" ToolTipService.ToolTip="Check drive availability without scanning for new files or moving your view." AutomationProperties.HelpText="Check drive availability without scanning for new files or moving your view."/><MenuFlyoutItem Text="Manage exclusions…" Click="ManageExclusions" ToolTipService.ToolTip="Review folder, source and extension rules; restore hidden media here." AutomationProperties.HelpText="Review folder, source and extension rules; restore hidden media here."/></MenuFlyout></Button.Flyout></Button>
     <Button x:Name="HeaderCollapseButton" Content="⌃" Click="ToggleHeader" AutomationProperties.Name="Toggle gallery controls" ToolTipService.ToolTip="Collapse or expand toolbar for a cleaner canvas (Ctrl+H)"/>
    </StackPanel>
   </Grid>

   <!-- Collapsible Action Toolbar -->
   <Border x:Name="GalleryToolbarRow" Grid.Row="1" Background="{ThemeResource LumaControl}" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
   <StackPanel Orientation="Horizontal" Spacing="3">
    <ComboBox x:Name="SortBox" SelectedIndex="4" SelectionChanged="FilterChanged" AutomationProperties.Name="Sort order" MinWidth="138" ToolTipService.ToolTip="Choose ordering. Date taken falls back to date modified when unavailable." AutomationProperties.HelpText="Choose the ordering. Date taken falls back to date modified when unavailable."><x:String>Date modified</x:String><x:String>Oldest modified</x:String><x:String>Name</x:String><x:String>File size</x:String><x:String>Date taken</x:String><x:String>File type</x:String><x:String>Filename</x:String><x:String>Resolution</x:String><x:String>Video duration</x:String></ComboBox>
    <ToggleButton x:Name="DescendingButton" Content="↓" IsChecked="True" Checked="DirectionChanged" Unchecked="DirectionChanged" AutomationProperties.Name="Descending order"/>
    <Button Content="View" AutomationProperties.Name="Gallery view options"><Button.Flyout><Flyout><ScrollViewer MaxHeight="480"><StackPanel Width="265" Spacing="8">
     <Button Content="Show timeline" Click="ShowTimeline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <ComboBox x:Name="LayoutModeBox" AutomationProperties.AutomationId="LayoutModeBox" Header="Gallery layout" SelectedIndex="0" SelectionChanged="LayoutModeChanged" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Switch between uniform 4:3 grid, aspect-accurate natural rows, or Moments with featured Favorites/Stacks.">
      <x:String>Uniform grid</x:String><x:String>Natural proportions</x:String><x:String>Moments (relevant size)</x:String>
     </ComboBox>
     <ComboBox x:Name="GroupBox" AutomationProperties.AutomationId="GroupBox" Header="Group by" SelectedIndex="2" SelectionChanged="GroupChanged" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Group the current timeline by year, month, day or session." AutomationProperties.HelpText="Group the current timeline by year, month or day."><x:String>None</x:String><x:String>Year</x:String><x:String>Month</x:String><x:String>Day</x:String><x:String>Day &amp; Session</x:String></ComboBox>
     <Slider x:Name="ThumbnailSlider" AutomationProperties.AutomationId="ThumbnailSlider" Header="Thumbnail size" Minimum="120" Maximum="320" Value="190" StepFrequency="10" ValueChanged="ThumbnailSizeChanged" ToolTipService.ToolTip="Change tile size. Ctrl+mouse wheel also resizes thumbnails." AutomationProperties.HelpText="Change tile size. Ctrl+mouse wheel also resizes thumbnails."/>
     <CheckBox x:Name="StackSimilarToggle" Content="Stack burst &amp; RAW+JPEG pairs" Checked="StackModeChanged" Unchecked="StackModeChanged" ToolTipService.ToolTip="Group consecutive shots within 30s and RAW+JPEG pairs into expandable stacks."/>
     <CheckBox x:Name="NamesToggle" AutomationProperties.AutomationId="NamesToggle" Content="Show filenames" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Show filenames beneath thumbnails." AutomationProperties.HelpText="Show filenames beneath thumbnails."/>
     <CheckBox x:Name="DetailsToggle" Content="Show dates and size" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Show dates and file sizes beneath thumbnails." AutomationProperties.HelpText="Show dates and file sizes beneath thumbnails."/>
     <CheckBox x:Name="ShowExactTimeToggle" Content="Show exact time (HH:mm:ss)" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Include hours, minutes, and seconds on card captions."/>
     <CheckBox x:Name="FitToggle" Content="Fit entire image" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Show the entire image instead of cropping it to fill the tile." AutomationProperties.HelpText="Show the entire image instead of cropping it to fill the tile."/>
     <CheckBox x:Name="CompactToggle" Content="Compact spacing" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Use less space between gallery tiles." AutomationProperties.HelpText="Use less space between gallery tiles."/>
     <CheckBox x:Name="FavoritesFirstToggle" Content="Pin favorites first" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged" ToolTipService.ToolTip="Keep starred favorites at the top of the current sort."/>
     <CheckBox x:Name="CommonToggle" Content="Everyday formats only" IsChecked="False" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged" ToolTipService.ToolTip="Limit browsing to everyday photo/video extensions. This does not exclude files from scans." AutomationProperties.HelpText="Limit browsing to everyday photo/video extensions. This does not exclude files from scans."/>
     <CheckBox x:Name="RecursiveToggle" Content="Include nested folders" IsChecked="True" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged" ToolTipService.ToolTip="Include media in subfolders of the current folder." AutomationProperties.HelpText="Include media in subfolders of the current folder."/>
    </StackPanel></ScrollViewer></Flyout></Button.Flyout></Button>

    <Button x:Name="FiltersButton" Content="Filters" AutomationProperties.Name="Filters"><Button.Flyout><Flyout><StackPanel Width="270" Spacing="10">
     <TextBlock Text="Filter library" FontWeight="SemiBold" FontSize="14"/>
     <CalendarDatePicker x:Name="FilterFromDate" Header="From date" DateChanged="FilterDateRangeChanged" HorizontalAlignment="Stretch"/>
     <CalendarDatePicker x:Name="FilterToDate" Header="To date" DateChanged="FilterDateRangeChanged" HorizontalAlignment="Stretch"/>
     <ComboBox x:Name="OrientationFilterBox" Header="Orientation" SelectedIndex="0" SelectionChanged="VisualFilterChanged" HorizontalAlignment="Stretch"><x:String>All orientations</x:String><x:String>Landscape</x:String><x:String>Portrait</x:String><x:String>Square</x:String></ComboBox>
     <ComboBox x:Name="MinSizeFilterBox" Header="Minimum size" SelectedIndex="0" SelectionChanged="VisualFilterChanged" HorizontalAlignment="Stretch"><x:String>Any size</x:String><x:String>&gt; 5 MB</x:String><x:String>&gt; 25 MB</x:String><x:String>&gt; 100 MB</x:String><x:String>&gt; 1 GB</x:String></ComboBox>
     <CheckBox x:Name="UntaggedFilterToggle" Content="Untagged items only" Checked="VisualFilterToggleChanged" Unchecked="VisualFilterToggleChanged"/>
     <CheckBox x:Name="HasGpsFilterToggle" Content="Has GPS coordinates" Checked="VisualFilterToggleChanged" Unchecked="VisualFilterToggleChanged"/>
     <ComboBox x:Name="TagFilterBox" Header="Filter by tag" PlaceholderText="Pick a tag" DropDownOpened="TagFilterBox_DropDownOpened" SelectionChanged="TagFilterBox_SelectionChanged" HorizontalAlignment="Stretch"/>
    </StackPanel></Flyout></Button.Flyout></Button>

    <Button Content="Months" Click="ShowTimeline" ToolTipService.ToolTip="Browse your timeline by month"/>
    <Button x:Name="MapButton" Content="Map" Click="OpenMapView" AutomationProperties.Name="Open map view" ToolTipService.ToolTip="Explore geotagged photos on an interactive map (opt-in online OpenStreetMap tiles or offline groups)."/>
    <ToggleButton x:Name="SelectMode" Content="Select" Checked="SelectModeChanged" Unchecked="SelectModeChanged" ToolTipService.ToolTip="Select several files with simple clicks"/>
    <Button Content="Reset" Click="ResetFilters" ToolTipService.ToolTip="Clear browsing filters. Exclusions remain active; restore them in Manage exclusions."/>
    <Button Content="Organize" AutomationProperties.Name="Organize tools"><Button.Flyout><MenuFlyout>
     <MenuFlyoutItem Text="Tag manager…" Click="OpenTagManagerMenu"/>
     <MenuFlyoutItem Text="Find duplicates…" Click="OpenDuplicatesMenu"/>
     <MenuFlyoutItem Text="Save view as Smart Collection…" Click="SaveCurrentAsSmartCollection"/>
     <MenuFlyoutSeparator/>
     <MenuFlyoutItem Text="Review / Undo last transfer…" Click="ReviewLastTransfer"/>
    </MenuFlyout></Button.Flyout></Button>
    <ToggleButton x:Name="InspectorToggle" AutomationProperties.AutomationId="InspectorToggle" Content="Details" ToolTipService.ToolTip="Show file details" Checked="InspectorChanged" Unchecked="InspectorChanged"/>
   </StackPanel>
   </Border>

   <!-- Contextual Navigation & Feedback Row -->
   <StackPanel Grid.Row="2" Spacing="6">
    <StackPanel x:Name="ResumeNavigation" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><TextBlock Text="Resumed here" VerticalAlignment="Center" Opacity="0.6"/><Button Content="Earlier items" Click="EarlierItems" ToolTipService.ToolTip="Load the previous 120 items while keeping your current position. No drive scan is needed." AutomationProperties.HelpText="Load the previous 120 items while keeping your current position. No drive scan is needed."/><Button Content="Back to start" Click="BackToStart" ToolTipService.ToolTip="Go to the beginning of this same filtered view." AutomationProperties.HelpText="Go to the beginning of this same filtered view."/></StackPanel>
    <StackPanel x:Name="MonthBrowser" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
     <Button x:Name="AllMonthsButton" Content="All months" Click="ClearMonth" ToolTipService.ToolTip="Clear only the month filter; keep other browsing filters." AutomationProperties.HelpText="Clear only the month filter; keep other browsing filters."/>
     <Button x:Name="NewerMonthButton" Content="Newer" Click="NewerMonth" AutomationProperties.Name="Newer month" ToolTipService.ToolTip="Show the next newer month with matching media." AutomationProperties.HelpText="Show the next newer month with matching media."/>
     <ComboBox x:Name="DateJump" PlaceholderText="Choose a month" SelectionChanged="JumpDate" Width="210" AutomationProperties.Name="Browse month" ToolTipService.ToolTip="Date taken when available; otherwise date modified. Counts follow your current filters."/>
     <Button x:Name="OlderMonthButton" Content="Older" Click="OlderMonth" AutomationProperties.Name="Older month" ToolTipService.ToolTip="Show the next older month with matching media." AutomationProperties.HelpText="Show the next older month with matching media."/>
     <CalendarDatePicker x:Name="DayJumpPicker" PlaceholderText="Jump to day" DateChanged="JumpToExactDay" AutomationProperties.Name="Jump to day" ToolTipService.ToolTip="Filter or jump to a specific local calendar day."/>
     <Button Content="▲" Click="HideMonthBrowser" AutomationProperties.Name="Hide month bar" ToolTipService.ToolTip="Hide month bar to reclaim space"/>
    </StackPanel>
    <TextBlock x:Name="SelectionHint" Text="Click to select files · Ctrl+A selects loaded files" Visibility="Collapsed" FontSize="12" Opacity="0.65"/>
    <ScrollViewer x:Name="FilterBar" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <StackPanel Orientation="Horizontal" Spacing="4">
      <StackPanel x:Name="ActiveFilters" Orientation="Horizontal" Spacing="4"/>
      <Button Content="+ Save collection" Click="SaveCurrentAsSmartCollection" Padding="8,4" FontSize="11" Background="{ThemeResource LumaControl}" ToolTipService.ToolTip="Save these active filters as a Smart Collection"/>
     </StackPanel>
    </ScrollViewer>
    <CalendarDatePicker x:Name="MemoryDate" Visibility="Collapsed" DateChanged="MemoryDateChanged" AutomationProperties.Name="Memory day" PlaceholderText="Choose a day" ToolTipService.ToolTip="Find recorded capture dates from this day in previous years." AutomationProperties.HelpText="Find recorded capture dates from this day in previous years."/>
    <InfoBar AutomationProperties.LiveSetting="Polite" x:Name="Notice" IsOpen="False" IsClosable="True"/>
   </StackPanel>

   <!-- Gallery Canvas + Right Details Inspector -->
   <Grid Grid.Row="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

    <!-- Uniform Grid View (Default) -->
    <GridView x:Name="MediaGrid" AutomationProperties.AutomationId="MediaGrid" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False" IsItemClickEnabled="False" DoubleTapped="GridDoubleTapped" SelectionChanged="SelectionChanged" RightTapped="GridRightTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContainerContentChanging="TileChanging" Loaded="GalleryLoaded" CanDragItems="True" DragItemsStarting="StartDrag" PointerWheelChanged="GalleryWheel">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Key}" FontSize="20" FontWeight="SemiBold" CharacterSpacing="-15" Margin="5,20,0,10"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></GridView.GroupStyle>
     <GridView.ItemTemplate><DataTemplate>
      <StackPanel Width="{Binding TileWidth}" Margin="{Binding Spacing}" Spacing="5" Opacity="{Binding CutOpacity}" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding TooltipText}" PointerEntered="CardPointerEntered" PointerExited="CardPointerExited">
       <Grid Height="{Binding TileHeight}">
        <!-- Subtle stack backing layer -->
        <Border Visibility="{Binding StackVisibility}" Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="12" Margin="4,-4,-4,4" Opacity="0.7"/>
        <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="12">
         <Grid CornerRadius="12">
          <FontIcon Glyph="&#xEB9F;" Visibility="{Binding PlaceholderVisibility}" Opacity="0.2" FontSize="28"/>
          <Image Source="{Binding Thumbnail}" Stretch="{Binding Fit}"/>
