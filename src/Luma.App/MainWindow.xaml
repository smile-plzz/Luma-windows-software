     <GridView.ItemTemplate><DataTemplate>
      <StackPanel Width="{Binding TileWidth}" Margin="{Binding Spacing}" Spacing="5" Opacity="{Binding CutOpacity}" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding TooltipText}" PointerEntered="CardPointerEntered" PointerExited="CardPointerExited">
