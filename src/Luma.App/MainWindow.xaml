      <TextBlock x:Name="MapSummaryText" Text="0 mapped" FontSize="12" Opacity="0.88"/>
     </Button>
     <Border x:Name="MapBackfillPill" Background="{ThemeResource LumaControl}" CornerRadius="999" Padding="10,3" Visibility="Collapsed" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <ProgressRing x:Name="MapBackfillRing" Width="14" Height="14" IsActive="False"/>
       <TextBlock x:Name="MapBackfillText" Text="Scanning files for GPS..." FontSize="11" VerticalAlignment="Center"/>
       <Button Content="Pause" Click="PauseMapBackfill" Padding="6,2" FontSize="11"/>
      </StackPanel>
     </Border>
    </StackPanel>

    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <Button x:Name="MapActiveFilterChip" Content="Filters active ✕" Click="MapResetFiltersClicked" Visibility="Collapsed" Background="{ThemeResource LumaControl}" CornerRadius="999" Padding="10,4" FontSize="11" ToolTipService.ToolTip="Clear active map filters"/>
      <Border Background="{ThemeResource LumaControl}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="2">
        <ToggleButton x:Name="MapViewHeatBtn" Content="Heat" IsChecked="True" Click="MapViewModeClicked" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Photo density heatmap"/>
        <ToggleButton x:Name="MapViewClustersBtn" Content="Clusters" Click="MapViewModeClicked" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Grouped photo bubbles"/>
        <ToggleButton x:Name="MapViewPlacesBtn" Content="Places" Click="MapViewModeClicked" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Visited places overview"/>
        <ToggleButton x:Name="MapViewPinsBtn" Content="Pins" Click="MapViewModeClicked" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Individual capture pins"/>
        <ToggleButton x:Name="MapViewTrailBtn" Content="Trail" Click="MapViewModeClicked" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Chronological travel path"/>
       </StackPanel>
      </Border>
      <Button x:Name="MapFiltersButton" Content="Filters" AutomationProperties.Name="Map filters" Background="{ThemeResource LumaControl}">
       <Button.Flyout>
        <Flyout x:Name="MapFiltersFlyout">
         <StackPanel Width="280" Spacing="10">
          <TextBlock Text="Filter map" FontWeight="SemiBold" FontSize="14"/>
          <Border Background="{ThemeResource LumaControl}" CornerRadius="8" Padding="3">
           <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="MapKindAll" Content="All" IsChecked="True" Click="MapKindFilterClicked" HorizontalAlignment="Stretch" Padding="6,4" FontSize="12"/>
            <ToggleButton x:Name="MapKindPhotos" Grid.Column="1" Content="Photos" Click="MapKindFilterClicked" HorizontalAlignment="Stretch" Padding="6,4" FontSize="12"/>
            <ToggleButton x:Name="MapKindVideos" Grid.Column="2" Content="Videos" Click="MapKindFilterClicked" HorizontalAlignment="Stretch" Padding="6,4" FontSize="12"/>
           </Grid>
          </Border>
          <ToggleButton x:Name="MapFavFilter" Content="★ Favorites only" Checked="MapFilterChanged" Unchecked="MapFilterChanged" Background="{ThemeResource LumaControl}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="12"/>
          <ComboBox x:Name="MapYearFilter" Header="Year" PlaceholderText="All years" HorizontalAlignment="Stretch" SelectionChanged="MapComboFilterChanged" FontSize="12"/>
          <ComboBox x:Name="MapSourceFilter" Header="Source" PlaceholderText="All sources" HorizontalAlignment="Stretch" SelectionChanged="MapComboFilterChanged" FontSize="12"/>
          <ComboBox x:Name="MapOriginFilter" Header="Pin source" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MapComboFilterChanged" FontSize="12">
           <x:String>All pins</x:String><x:String>EXIF &amp; Video</x:String><x:String>Manual pins</x:String>
          </ComboBox>
          <TextBox x:Name="MapSearchBox" Header="Search place, camera, or file" PlaceholderText="Tokyo, Pixel, DSC..." TextChanged="MapSearchTextChanged" FontSize="12"/>
          <CheckBox x:Name="MapMatchGalleryToggle" Content="Match current gallery filters" Checked="MapFilterChanged" Unchecked="MapFilterChanged" FontSize="12"/>
          <Button x:Name="MapResetFiltersBtn" Content="Clear map filters" Click="MapResetFiltersClicked" HorizontalAlignment="Stretch"/>
         </StackPanel>
        </Flyout>
       </Button.Flyout>
      </Button>
      <ToggleButton x:Name="MapDrawerToggle" Content="Locations" IsChecked="False" Checked="MapChromeToggled" Unchecked="MapChromeToggled" Background="{ThemeResource LumaControl}" ToolTipService.ToolTip="Show or hide visited places, clusters, and unlocated media."/>
      <ToggleButton x:Name="MapStripToggle" Content="Filmstrip" IsChecked="False" Checked="MapChromeToggled" Unchecked="MapChromeToggled" Background="{ThemeResource LumaControl}" ToolTipService.ToolTip="Show or hide photos visible in the current map view."/>
      <ToggleButton x:Name="MapPinModeToggle" Content="Pin mode" Checked="MapPinModeToggled" Unchecked="MapPinModeToggled" Background="{ThemeResource LumaControl}" ToolTipService.ToolTip="Click anywhere on the map to assign catalog-only coordinates."/>
      <Button x:Name="MapScanGpsButton" Content="Scan GPS" Click="TriggerMapBackfill" Background="{ThemeResource LumaControl}" ToolTipService.ToolTip="Check connected sources for uncached GPS, video ISO-6709, or XMP location tags. Checked files remain cached."/>
      <Button x:Name="MapToggleModeButton" Content="Load online map (this session)" Click="ToggleMapModeClicked" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Toggle between local offline coordinate canvas and opt-in OpenStreetMap tiles for this session."/>
     </StackPanel>
    </ScrollViewer>
   </Grid>

   <!-- Full-Bleed Map Canvas (Offline / Online) + Collapsible Visited Places Drawer -->
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <InfoBar x:Name="MapNotice" Grid.ColumnSpan="2" Canvas.ZIndex="20" IsOpen="False" IsClosable="True" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="760" Margin="16,12,16,0"/>

    <!-- Offline Interactive Map + Slim Floating Controls + Non-Overlapping Bottom Chrome -->
    <Grid x:Name="MapOfflinePanel">
     <Canvas x:Name="OfflineMapCanvas" Background="{ThemeResource LumaSidebar}" SizeChanged="OfflineCanvas_SizeChanged" PointerPressed="OfflineCanvas_PointerPressed" PointerMoved="OfflineCanvas_PointerMoved" PointerReleased="OfflineCanvas_PointerReleased" PointerWheelChanged="OfflineCanvas_PointerWheelChanged"/>
     <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="4" Background="{ThemeResource LumaElevatedSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,16">
      <Button Content="+" Click="OfflineZoomInClicked" Padding="8,4" ToolTipService.ToolTip="Zoom in"/>
      <Button Content="-" Click="OfflineZoomOutClicked" Padding="8,4" ToolTipService.ToolTip="Zoom out"/>
      <Button Content="Fit" Click="OfflineFitClicked" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Fit all mapped items"/>
      <Button Content="Show view in gallery" Click="OfflineFilterBoundsClicked" Padding="10,4" FontSize="12" Background="{ThemeResource LumaControl}"/>
     </StackPanel>

     <Border x:Name="OfflinePinHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="12,6" CornerRadius="999" Background="{ThemeResource SystemControlHighlightAccentBrush}" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,16" Visibility="Collapsed">
      <TextBlock x:Name="OfflinePinHintText" Text="Click anywhere on the map to assign catalog coordinates" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
     </Border>

     <!-- Stacked Non-Overlapping Bottom Overlays -->
     <StackPanel VerticalAlignment="Bottom" Spacing="8" Margin="12" IsHitTestVisible="True">
      <Border x:Name="MapConsentCard" HorizontalAlignment="Center" MaxWidth="780" Background="{ThemeResource LumaElevatedSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,7" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,16">
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
         <TextBlock Text="Online Map Privacy Notice (One-Time Per Session)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
         <TextBlock Text="Public OpenStreetMap tiles load only after opt-in; your files and coordinates stay on your PC." FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Load online map" Click="GrantMapOnlineConsent" Style="{StaticResource AccentButtonStyle}" Padding="10,4" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Click="DismissMapConsentBanner" ToolTipService.ToolTip="Hide notice" AutomationProperties.Name="Hide online map notice" VerticalAlignment="Center" Padding="6,4">
         <FontIcon Glyph="&#xE711;" FontSize="10"/>
        </Button>
       </Grid>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border x:Name="OfflineHeatLegend" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="9,5" CornerRadius="9" Background="{ThemeResource LumaElevatedSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,16">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
         <TextBlock Text="Less" FontSize="11" Opacity="0.7"/>
         <Border Width="68" Height="7" CornerRadius="4">
          <Border.Background>
           <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#BF38BDF8" Offset="0"/>
            <GradientStop Color="#DF10B981" Offset="0.45"/>
            <GradientStop Color="#F0F59E0B" Offset="0.75"/>
            <GradientStop Color="#FAEF4444" Offset="1"/>
           </LinearGradientBrush>
          </Border.Background>
         </Border>
         <TextBlock Text="More photos" FontSize="11" Opacity="0.7"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,4" CornerRadius="7" Background="{ThemeResource LumaElevatedSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" Opacity="0.88" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,16">
        <TextBlock x:Name="OfflineMapModeBadge" Text="Offline coordinate canvas" FontSize="10.5"/>
       </Border>
      </Grid>
     </StackPanel>
    </Grid>

    <!-- Full-Bleed Lazy WebView2 Host -->
    <Grid x:Name="MapWebHost" Visibility="Collapsed" Margin="0"/>

    <!-- Right Collapsible Drawer: Places | Clusters | Place Tags | Unlocated (Collapsed by Default) -->
    <Border x:Name="MapDrawerPanel" Grid.Column="1" Width="340" Visibility="Collapsed" Background="{ThemeResource LumaSidebar}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1,0,0,0" Padding="12" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,16">
     <Grid RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Locations &amp; spots" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Click="CloseMapDrawerClicked" Padding="6,4" AutomationProperties.Name="Close locations drawer" ToolTipService.ToolTip="Close locations drawer">
        <FontIcon Glyph="&#xE711;" FontSize="11"/>
       </Button>
      </Grid>
      <TextBox x:Name="MapDrawerFilterBox" Grid.Row="1" PlaceholderText="Filter places, spots, or filenames…" TextChanged="MapDrawerFilterChanged" FontSize="12" AutomationProperties.Name="Filter drawer locations"/>
      <Border Grid.Row="2" Background="{ThemeResource LumaControl}" CornerRadius="9" Padding="3">
       <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="MapTabPlaces" Content="Places" IsChecked="True" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="4,4" FontSize="11"/>
        <ToggleButton x:Name="MapTabClusters" Grid.Column="1" Content="Spots" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="4,4" FontSize="11"/>
        <ToggleButton x:Name="MapTabPlaceTags" Grid.Column="2" Content="Tags" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="4,4" FontSize="11"/>
        <ToggleButton x:Name="MapTabUnlocated" Grid.Column="3" Content="Unlocated" Click="MapDrawerTabClicked" HorizontalAlignment="Stretch" Padding="4,4" FontSize="11"/>
       </Grid>
      </Border>

      <Grid Grid.Row="3">
       <TextBlock x:Name="MapDrawerEmpty" Text="No location items in this view." TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="6,12" Visibility="Collapsed"/>

       <ListView x:Name="MapPlacesList" SelectionMode="None">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="6">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Focus" Tag="{Binding}" Click="MapPlaceFocusClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="Show in gallery" Tag="{Binding}" Click="MapPlaceFilterClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="Open" Tag="{Binding}" Click="MapPlaceOpenClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11" ToolTipService.ToolTip="Open sample photo in your default Windows app"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>

       <ListView x:Name="MapOfflineGroupsList" SelectionMode="None" Visibility="Collapsed">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="6">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Zoom" Tag="{Binding}" Click="MapOfflineGroupZoomClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="Show in gallery" Tag="{Binding}" Click="MapOfflineGroupFilterClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
            <Button Content="OSM" Tag="{Binding}" Click="MapOfflineGroupBrowserClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>

       <ListView x:Name="MapPlaceTagsList" SelectionMode="None" Visibility="Collapsed">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="5">
           <TextBlock Text="{Binding LocationName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Open" Tag="{Binding}" Click="MapDrawerItemOpenClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11" ToolTipService.ToolTip="Open original in your default Windows app"/>
            <Button Content="Pin coords…" Tag="{Binding}" Click="MapDrawerItemPinClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>

       <ListView x:Name="MapUnlocatedList" SelectionMode="None" Visibility="Collapsed">
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
          <StackPanel Spacing="5">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
           <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Open" Tag="{Binding}" Click="MapDrawerItemOpenClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11" ToolTipService.ToolTip="Open original in your default Windows app"/>
            <Button Content="Pin on map…" Tag="{Binding}" Click="MapDrawerItemPinClicked" Background="{ThemeResource LumaControl}" Padding="8,3" FontSize="11"/>
           </StackPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Grid>
     </Grid>
    </Border>
   </Grid>

   <!-- Optional Collapsible Viewport Filmstrip Bar (Collapsed by Default) -->
   <Border x:Name="MapFilmstripBar" Grid.Row="2" Height="110" Visibility="Collapsed" Background="{ThemeResource LumaSidebar}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="0,1,0,0" Padding="12,6">
    <Grid RowSpacing="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="MapFilmstripHeader" Text="Visible in map area" FontSize="11" Opacity="0.65"/>
     <ListView x:Name="MapFilmstripList" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="MapFilmstripItemClicked" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="0"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate>
       <Border Width="108" Height="74" CornerRadius="8" Background="{ThemeResource LumaCardSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" ToolTipService.ToolTip="{Binding Tooltip}">
        <Grid CornerRadius="8">
         <FontIcon Glyph="&#xEB9F;" Opacity="0.22" FontSize="20"/>
         <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
         <Border VerticalAlignment="Bottom" Background="#A6000000" Padding="5,2">
          <TextBlock Text="{Binding Label}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis"/>
         </Border>
        </Grid>
       </Border>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
  </Grid>
  </Grid> <!-- End WorkspaceRoot -->
  </ContentControl>

  <!-- Transparent Loading Veil & Progress Feedback Overlay -->
  <Grid x:Name="LoadingVeil" Canvas.ZIndex="100" Visibility="Visible" IsHitTestVisible="True" Background="{ThemeResource LumaModalScrim}" AutomationProperties.LiveSetting="Polite">
   <Border x:Name="LoadingCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Padding="24,20" CornerRadius="14" Background="{ThemeResource LumaElevatedSurface}" BorderBrush="{ThemeResource LumaCardBorder}" BorderThickness="1" Shadow="{StaticResource FloatingPillShadow}" Translation="0,0,24">
    <StackPanel Spacing="12">
     <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="True"/>
      <TextBlock x:Name="LoadingTitle" Text="Opening your library" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock x:Name="LoadingDetail" Text="Checking catalog health safely. Originals remain untouched." FontSize="12.5" Opacity="0.78" TextWrapping="Wrap"/>
     <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Minimum="0" Maximum="100" HorizontalAlignment="Stretch"/>
     <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,2,0,0">
      <Button x:Name="LoadingRetryButton" Content="Try again" Click="RetryStartupLockClicked" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"/>
      <Button x:Name="LoadingExitButton" Content="Exit" Click="ExitAppClicked" Visibility="Collapsed" Background="{ThemeResource LumaControl}"/>
      <Button x:Name="LoadingCancelButton" Content="Cancel" Click="CancelLoadingOverlayClicked" Visibility="Collapsed" Background="{ThemeResource LumaControl}"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
 </ContentControl>
</Window>
